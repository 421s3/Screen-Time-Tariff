PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/screen-time-tariff
# Database name (the connection string can leave it out)
MONGODB_DB=screen-time-tariff
SOLANA_RPC_URL=https://api.devnet.solana.com
# off = calculate penalties only, mock = in-memory copy of the program (no deploy needed),
# devnet = real program (needs PROGRAM_ID and the funded oracle key)
CHAIN_MODE=mock
# Xayden's program; only used in devnet mode, once it's deployed
PROGRAM_ID=GfR8egohvnFsdcLfPEJFccd1an274TVsfPhpWsUR3CGi
ORACLE_KEYPAIR_PATH=./keys/oracle.json
# Missed check-ins: tracker silence beyond OFFLINE_GRACE_SEC counts as blocked time ("Tracker offline").
# Keep false while developing (or your own laptop gets charged); set true for the demo.
ENFORCE_OFFLINE=false
OFFLINE_GRACE_SEC=120
# How often the worker charges penalties, syncs the chain, and settles. Use 5 for the demo.
WORKER_INTERVAL_SEC=30
