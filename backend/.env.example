PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/screen-time-tariff
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=REPLACE_WITH_PROGRAM_ID
ORACLE_KEYPAIR_PATH=./keys/oracle.json
GEMINI_API_KEY=REPLACE_ME
# Count tracker silence as over-limit time. Keep false while developing.
ENFORCE_OFFLINE=false
OFFLINE_GRACE_SEC=120
# Penalty worker interval
WORKER_INTERVAL_SEC=30
